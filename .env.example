# Base URL of the telemetry API the ESP32 devices report to.
# The dashboard polls <NEXT_PUBLIC_API_URL>/api/latest for the newest readings.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Directory the firmware upload endpoint writes .bin files into.
# Point this at the folder your OTA server serves from.
# Defaults to ./firmware when unset.
# FIRMWARE_DIR=/srv/env-monitor/firmware
